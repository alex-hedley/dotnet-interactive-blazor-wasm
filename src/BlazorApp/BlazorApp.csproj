<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable trimming so Roslyn reflection-heavy paths are preserved -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      Disable WebCIL packaging so assemblies are published as plain .dll files.
      WebCIL wraps .NET PE bytes in a WebAssembly container; MetadataReference.CreateFromImage
      requires raw PE/ECMA-335 bytes, so WebCIL files would fail at compile time.
    -->
    <WasmEnableWebcil>false</WasmEnableWebcil>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.24" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.24" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

</Project>
