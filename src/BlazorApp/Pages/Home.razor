@page "/"
@using Microsoft.CodeAnalysis
@using Microsoft.CodeAnalysis.CSharp
@using Microsoft.CodeAnalysis.Emit
@using System.IO
@using System.Net.Http
@using System.Net.Http.Json
@using System.Reflection
@using System.Text.Json.Serialization
@inject HttpClient Http

<PageTitle>.NET Interactive (WASM)</PageTitle>

<h1>🚀 .NET Interactive — Blazor WASM</h1>
<p class="lead">Write and run C# code directly in your browser using Roslyn compiled to WebAssembly.</p>

<div class="editor-container">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label class="fw-bold" for="codeEditor">C# Code</label>
        <div>
            <button class="btn btn-sm btn-outline-secondary me-2" @onclick="LoadSample">Load Sample</button>
            <button class="btn btn-sm btn-outline-danger me-2" @onclick="ClearOutput">Clear Output</button>
            <button class="btn btn-primary" @onclick="RunCode" disabled="@_isRunning">
                @if (_isRunning)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Running…</span>
                }
                else
                {
                    <span>▶ Run</span>
                }
            </button>
        </div>
    </div>
    <textarea id="codeEditor"
              class="form-control font-monospace"
              rows="14"
              spellcheck="false"
              @bind="_code"
              @bind:event="oninput"
              placeholder="Enter C# code here…"></textarea>
</div>

@if (_statusMessage is not null)
{
    <div class="alert @_statusClass mt-3" role="alert">@_statusMessage</div>
}

@if (_output is not null)
{
    <div class="mt-3">
        <label class="fw-bold">Output</label>
        <pre class="output-box">@_output</pre>
    </div>
}

@if (_diagnostics.Count > 0)
{
    <div class="mt-3">
        <label class="fw-bold text-danger">Diagnostics</label>
        <ul class="list-group">
            @foreach (var d in _diagnostics)
            {
                <li class="list-group-item list-group-item-danger font-monospace small">@d</li>
            }
        </ul>
    </div>
}

<div class="mt-4 text-muted small">
    <strong>Status:</strong> @_loadStatus
</div>

<style>
    .editor-container { background: #1e1e1e; border-radius: 6px; padding: 1rem; }
    #codeEditor { background: #1e1e1e; color: #d4d4d4; border: 1px solid #444; font-size: 0.9rem; resize: vertical; }
    .output-box { background: #0d0d0d; color: #a8ff78; border: 1px solid #333; border-radius: 4px; padding: 1rem; min-height: 80px; white-space: pre-wrap; word-break: break-all; }
    label.fw-bold { color: #ccc; }
</style>

@code {
    private string _code = @"using System;

int Fibonacci(int n) => n <= 1 ? n : Fibonacci(n - 1) + Fibonacci(n - 2);

for (int i = 0; i <= 10; i++)
    Console.WriteLine($""Fibonacci({i}) = {Fibonacci(i)}"");";

    private string? _output;
    private string? _statusMessage;
    private string _statusClass = "alert-info";
    private List<string> _diagnostics = new();
    private bool _isRunning;
    private string _loadStatus = "Initializing…";

    private List<MetadataReference> _references = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReferencesAsync();
    }

    /// <summary>
    /// Download all assemblies listed in the Blazor boot manifest and
    /// create Roslyn MetadataReferences from their raw bytes so that
    /// Roslyn can resolve types without needing a file system.
    /// </summary>
    private async Task LoadReferencesAsync()
    {
        try
        {
            _loadStatus = "Loading boot manifest…";
            StateHasChanged();

            // The boot manifest is embedded inside the generated blazor.boot.json
            var manifest = await Http.GetFromJsonAsync<BootManifest>("_framework/blazor.boot.json");
            if (manifest?.Resources is null)
            {
                _loadStatus = "⚠️ Could not read boot manifest.";
                return;
            }

            var assemblies = new Dictionary<string, string>();
            var skippedAssemblies = new List<string>();

            // Collect both coreAssembly and assembly entries
            if (manifest.Resources.CoreAssembly is not null)
                foreach (var kv in manifest.Resources.CoreAssembly)
                    assemblies[kv.Key] = kv.Value;

            if (manifest.Resources.Assembly is not null)
                foreach (var kv in manifest.Resources.Assembly)
                    assemblies[kv.Key] = kv.Value;

            int loaded = 0;
            int total = assemblies.Count;

            foreach (var (name, _) in assemblies)
            {
                _loadStatus = $"Loading assemblies… {loaded}/{total}";
                StateHasChanged();
                try
                {
                    var bytes = await Http.GetByteArrayAsync($"_framework/{name}");
                    _references.Add(MetadataReference.CreateFromImage(bytes));
                }
                catch
                {
                    skippedAssemblies.Add(name);
                }
                loaded++;
            }

            _loadStatus = skippedAssemblies.Count > 0
                ? $"✅ Ready — {_references.Count} assemblies loaded ({skippedAssemblies.Count} skipped: {string.Join(", ", skippedAssemblies)})."
                : $"✅ Ready — {_references.Count} assemblies loaded.";
        }
        catch (Exception ex)
        {
            _loadStatus = $"⚠️ Failed to load assemblies: {ex.Message}";
        }

        StateHasChanged();
    }

    private async Task RunCode()
    {
        if (_isRunning) return;
        _isRunning = true;
        _output = null;
        _diagnostics.Clear();
        _statusMessage = null;
        StateHasChanged();

        await Task.Yield(); // let UI repaint

        try
        {
            var result = CompileAndRun(_code);
            _output = result.Output;
            _diagnostics = result.Diagnostics;

            if (result.Success)
            {
                _statusMessage = "✅ Execution completed successfully.";
                _statusClass = "alert-success";
            }
            else
            {
                _statusMessage = "❌ Compilation or execution failed. See diagnostics below.";
                _statusClass = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"💥 Unexpected error: {ex.Message}";
            _statusClass = "alert-danger";
        }
        finally
        {
            _isRunning = false;
        }
    }

    private ExecutionResult CompileAndRun(string code)
    {
        // Wrap the script body in a class/method so it compiles as a script-style entry point
        var parseOptions = CSharpParseOptions.Default.WithKind(SourceCodeKind.Script);
        var syntaxTree = CSharpSyntaxTree.ParseText(code, parseOptions);

        var compilationOptions = new CSharpCompilationOptions(
            OutputKind.DynamicallyLinkedLibrary,
            usings: new[]
            {
                "System",
                "System.Collections.Generic",
                "System.Linq",
                "System.Text",
                "System.Threading.Tasks",
            },
            allowUnsafe: false,
            optimizationLevel: OptimizationLevel.Debug,
            nullableContextOptions: NullableContextOptions.Disable);

        var compilation = CSharpCompilation.CreateScriptCompilation(
            assemblyName: "InteractiveScript",
            syntaxTree: syntaxTree,
            references: _references,
            options: compilationOptions);

        using var peStream = new MemoryStream();
        var emitResult = compilation.Emit(peStream);

        var diagnostics = emitResult.Diagnostics
            .Where(d => d.Severity >= DiagnosticSeverity.Warning)
            .Select(d => d.ToString())
            .ToList();

        if (!emitResult.Success)
            return new ExecutionResult(false, null, diagnostics);

        peStream.Seek(0, SeekOrigin.Begin);
        var assembly = Assembly.Load(peStream.ToArray());

        // Capture Console output
        var oldOut = Console.Out;
        var sb = new System.Text.StringBuilder();
        using var sw = new StringWriter(sb);
        Console.SetOut(sw);

        string? output = null;
        try
        {
            // Script compilation generates a submission type with a static <Factory> method
            // that takes object[2] and returns Task<object>.
            bool invoked = false;
            foreach (var type in assembly.GetTypes())
            {
                var factory = type.GetMethod("<Factory>",
                    BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
                if (factory is not null)
                {
                    var result = factory.Invoke(null, new object[] { new object?[2] });
                    if (result is Task task)
                        task.GetAwaiter().GetResult();
                    invoked = true;
                    break;
                }
            }

            if (!invoked)
                sb.AppendLine("(no output — could not find script entry point)");

            output = sw.ToString();
        }
        finally
        {
            Console.SetOut(oldOut);
        }

        return new ExecutionResult(true, output, diagnostics);
    }

    private void ClearOutput()
    {
        _output = null;
        _diagnostics.Clear();
        _statusMessage = null;
    }

    private void LoadSample()
    {
        _code = @"using System;
using System.Linq;

// Generate the first 15 primes
var primes = Enumerable.Range(2, 100)
    .Where(n => Enumerable.Range(2, (int)Math.Sqrt(n) - 1).All(i => n % i != 0))
    .Take(15);

Console.WriteLine(""First 15 prime numbers:"");
Console.WriteLine(string.Join("", "", primes));";
        ClearOutput();
    }

    private record ExecutionResult(bool Success, string? Output, List<string> Diagnostics);

    // ── BootManifest deserialization types ──────────────────────────────────

    private class BootManifest
    {
        [JsonPropertyName("resources")]
        public BootResources? Resources { get; set; }
    }

    private class BootResources
    {
        [JsonPropertyName("coreAssembly")]
        public Dictionary<string, string>? CoreAssembly { get; set; }

        [JsonPropertyName("assembly")]
        public Dictionary<string, string>? Assembly { get; set; }
    }
}
