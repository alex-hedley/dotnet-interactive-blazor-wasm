<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Trimming is disabled because Roslyn / .NET Interactive use heavy reflection
      that the IL trimmer cannot analyse statically.
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      AOT is disabled for the same reason — Roslyn generates IL at runtime so
      native AOT cannot pre-compile everything.
    -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.DotNet.Interactive.CSharp provides the CSharpKernel that compiles
      and executes C# code using Roslyn — no child process required.
    -->
    <PackageReference Include="Microsoft.DotNet.Interactive.CSharp" Version="1.0.0-beta.26120.1" />
  </ItemGroup>

</Project>
